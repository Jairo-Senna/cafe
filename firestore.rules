rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para a aplicação Financeiro Refeições
    // Coleção base isolada por UID do usuário autenticado:
    match /gestao-financeira/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /colaboradores/{colabId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /receitas/{receitaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Regra alternativa permissiva (caso esteja em ambiente de desenvolvimento ou testes):
    // Descomente as linhas abaixo se preferir liberar temporariamente sem exigir autenticação estrita:
    // match /{document=**} {
    //   allow read, write: if request.auth != null;
    // }
  }
}
